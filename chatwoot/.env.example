# Скопируйте в .env и заполните:  cp .env.example .env
# Секрет сгенерируйте командой:   openssl rand -hex 64

SECRET_KEY_BASE=замените_на_вывод_openssl_rand_hex_64

# Публичный адрес, по которому открывается Chatwoot (важно для виджета и ссылок в письмах)
FRONTEND_URL=http://localhost:3000

DEFAULT_LOCALE=ru
TZ=Europe/Moscow

# За reverse-proxy с HTTPS поставьте true
FORCE_SSL=false

# Разрешить регистрацию первого аккаунта. После создания своего аккаунта
# поставьте false, чтобы посторонние не регистрировались на вашем сервере.
ENABLE_ACCOUNT_SIGNUP=true

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=chatwoot

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=chatwoot

RAILS_ENV=production
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
INSTALLATION_ENV=docker

# --- Почта (уведомления агентам, приглашения). Можно заполнить позже. ---
MAILER_SENDER_EMAIL=Chatwoot <chatwoot@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# --- Хранилище вложений (local = том docker'а; можно S3-совместимое) ---
ACTIVE_STORAGE_SERVICE=local
